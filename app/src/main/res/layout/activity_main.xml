<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0a0a0f" android:padding="24dp">
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="NOX — عالمك الخاص" android:textColor="#fff" android:textSize="28sp"
        android:textStyle="bold" android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/sub" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="تم تحويل الموقع لتطبيق Kotlin.Android\nالرابط العام على GitHub: github.com/yasinav725-creator/nox-android" android:textColor="#8e8e9f"
        android:textSize="14sp" app:layout_constraintTop_toBottomOf="@id/title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <Button android:id="@+id/open" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="فتح الموقع الأصلي" android:backgroundTint="#8a0e2a" android:textColor="#fff"
        app:layout_constraintTop_toBottomOf="@id/sub" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
